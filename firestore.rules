rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test path
    match /test/{docId} {
      allow read: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings (payment details, UPI, QR code)
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
